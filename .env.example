# Postgres
POSTGRES_USER=fechamento
POSTGRES_PASSWORD=fechamento
POSTGRES_DB=fechamento_importacoes
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+psycopg2://fechamento:fechamento@db:5432/fechamento_importacoes
JWT_SECRET_KEY=troque-esta-chave-em-producao
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
ADMIN_EMAIL=amanda.martins@gocase.com
ADMIN_PASSWORD=troque-esta-senha

# Google Drive (ver README - Fase 2 - para os passos de criação do OAuth Client)
GOOGLE_OAUTH_CREDENTIALS_PATH=/app/secrets/credentials.json
GOOGLE_OAUTH_TOKEN_PATH=/app/secrets/token.json
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/drive/oauth/callback
DRIVE_IMPORTACOES_FOLDER_NAME=Importações

# Tolerância de variação cambial (percentual, ex 0.02 = 2%)
TOLERANCIA_VARIACAO_CAMBIAL=0.02

# Frontend
VITE_API_URL=http://localhost:8000
